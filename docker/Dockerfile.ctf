FROM kalilinux/kali-rolling AS forgeflag-core

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        binwalk \
        build-essential \
        checksec \
        curl \
        ffuf \
        file \
        foremost \
        gdb \
        gdbserver \
        git \
        hashcat \
        john \
        jq \
        less \
        libimage-exiftool-perl \
        libgmp-dev \
        libmpc-dev \
        libmpfr-dev \
        libssl-dev \
        nmap \
        p7zip-full \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        radare2 \
        socat \
        sqlite3 \
        steghide \
        sqlmap \
        tcpdump \
        tshark \
        unzip \
        wget \
        yara \
    && python3 -m venv /opt/forgeflag-venv \
    && /opt/forgeflag-venv/bin/pip install --no-cache-dir \
        ROPGadget \
        angr \
        capstone \
        mcp[cli] \
        pwntools \
        pycryptodome \
        git+https://github.com/RsaCtfTool/RsaCtfTool.git \
        ropper \
        z3-solver \
    && if ! command -v RsaCtfTool >/dev/null 2>&1 && command -v RsaCtfTool.py >/dev/null 2>&1; then ln -s "$(command -v RsaCtfTool.py)" /usr/local/bin/RsaCtfTool; fi \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/forgeflag-venv/bin:${PATH}"
WORKDIR /workspace


FROM forgeflag-core AS forgeflag-volatility

RUN /opt/forgeflag-venv/bin/pip install --no-cache-dir volatility3


FROM forgeflag-core AS forgeflag-sagemath

RUN apt-get update \
    && apt-get install -y --no-install-recommends sagemath \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


FROM forgeflag-core AS forgeflag-ghidra-headless

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ghidra \
        openjdk-17-jre-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV GHIDRA_HEADLESS=/usr/bin/analyzeHeadless


FROM forgeflag-core AS forgeflag-default

CMD ["/bin/bash"]
