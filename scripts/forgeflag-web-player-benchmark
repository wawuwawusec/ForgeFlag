def apply_run_mode(cases: list[dict[str, object]], llm: bool, both: bool) -> list[dict[str, object]]:
    deterministic = [_case_variant(case, run_profile="deterministic", llm_enabled=False) for case in cases]
    llm_cases = [_case_variant(case, run_profile="llm", llm_enabled=True) for case in cases]
    if both:
        return [item for pair in zip(deterministic, llm_cases) for item in pair]
    if llm:
        return llm_cases
    return deterministic


def _case_variant(case: dict[str, object], run_profile: str, llm_enabled: bool) -> dict[str, object]:
    base_id = str(case["challenge_id"])
    variant = dict(case)
    variant["base_challenge_id"] = base_id
    variant["run_profile"] = run_profile
    variant["llm_enabled"] = llm_enabled
    if run_profile == "llm":
        variant["challenge_id"] = f"{base_id}-llm"
    return variant


def _case_selected(case: dict[str, object], requested: set[str]) -> bool:
    return str(case.get("challenge_id")) in requested or str(case.get("base_challenge_id")) in requested


def _case_listing(case: dict[str, object]) -> dict[str, object]:
    return {
        "challenge_id": case["challenge_id"],
        "base_challenge_id": case.get("base_challenge_id", case["challenge_id"]),
        "run_profile": case.get("run_profile", "deterministic"),
        "category": case["category"],
        "title": case["title"],
        "expected_flag": case["expected_flag"],
        "llm_enabled": case["llm_enabled"],
        "via": case["via"],
        "expected_agents": list(case["expected_agents"]),  # type: ignore[arg-type]
        "attachments": [Path(path).name for path in case["attachments"]],  # type: ignore[arg-type]
    }


def _playwright_bin() -> Path | None:
    local_bin = WORKDIR / "node_modules" / ".bin" / "playwright"
    if local_bin.exists():
        return local_bin
    path_bin = shutil.which("playwright")
    return Path(path_bin) if path_bin else None


def run_playwright(
    base_url: str,
    cases: list[dict[str, object]],
    playwright_bin: Path,
    headed: bool,
    keep: bool,
    raw_json: bool = False,
) -> int:
    spec = _playwright_spec(base_url.rstrip("/"), cases, keep)
    run_dir = WORKDIR / "playwright"
    run_dir.mkdir(parents=True, exist_ok=True)
    spec_path = run_dir / "forgeflag-web-player.spec.js"
    config_path = run_dir / "playwright.config.js"
    spec_path.write_text(spec, encoding="utf-8")
    config_path.write_text(
        "module.exports = { testDir: __dirname, testMatch: 'forgeflag-web-player.spec.js', workers: 1, timeout: 90000 };\n",
        encoding="utf-8",
    )
    command = [str(playwright_bin), "test", "--config", str(config_path), "--reporter=json"]
    if headed:
        command.append("--headed")
    completed = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=False, timeout=180)
    if raw_json:
        if completed.stdout:
            print(completed.stdout)
        if completed.stderr:
            print(completed.stderr, file=sys.stderr)
        return completed.returncode
    if completed.stdout:
        try:
            report = json.loads(completed.stdout)
        except json.JSONDecodeError:
            print(completed.stdout)
        else:
            print(format_playwright_summary(summarize_playwright_report(report, cases)))
    if completed.stderr:
        print(completed.stderr, file=sys.stderr)
    return completed.returncode


def summarize_playwright_report(
    report: dict[str, object],
    benchmark_cases: list[dict[str, object]] | None = None,
) -> dict[str, object]:
    specs = _collect_playwright_specs(report.get("suites", []))
    case_metadata = {
        str(case.get("challenge_id") or ""): {
            "category": str(case.get("category") or "unknown"),
            "run_profile": str(case.get("run_profile") or "deterministic"),
            "expected_agents": [str(agent) for agent in case.get("expected_agents", [])]
            if isinstance(case.get("expected_agents"), list)
            else [],
        }
        for case in (benchmark_cases or [])
        if case.get("challenge_id")
    }
    cases = []
    categories: dict[str, dict[str, int]] = {}
    profiles: dict[str, dict[str, int]] = {}
    for spec in specs:
        title = str(spec.get("title") or "unnamed")
        passed = bool(spec.get("ok"))
        metadata = case_metadata.get(title, {})
        category = str(metadata.get("category") or "unknown")
        run_profile = str(metadata.get("run_profile") or "deterministic")
        expected_agents = metadata.get("expected_agents") if isinstance(metadata.get("expected_agents"), list) else []
        category_row = categories.setdefault(category, {"passed": 0, "total": 0})
        category_row["total"] += 1
        profile_row = profiles.setdefault(run_profile, {"passed": 0, "total": 0})
        profile_row["total"] += 1
        if passed:
            category_row["passed"] += 1
            profile_row["passed"] += 1
        cases.append(
            {
                "title": title,
                "status": "PASS" if passed else "FAIL",
                "category": category,
                "run_profile": run_profile,
                "expected_agents": expected_agents,
            }
        )
    passed_count = sum(1 for case in cases if case["status"] == "PASS")
    return {
        "passed": passed_count,
        "total": len(cases),
        "duration_ms": int((report.get("stats") or {}).get("duration") or 0) if isinstance(report.get("stats"), dict) else 0,
        "profiles": profiles,
        "categories": categories,
        "cases": cases,
    }


def format_playwright_summary(summary: dict[str, object]) -> str:
    passed = int(summary.get("passed") or 0)
    total = int(summary.get("total") or 0)
    duration_ms = int(summary.get("duration_ms") or 0)
    lines = [f"ForgeFlag browser player benchmark: {passed}/{total} passed"]
    if duration_ms:
        lines.append(f"Duration: {duration_ms / 1000:.1f}s")
    profiles = summary.get("profiles")
    if isinstance(profiles, dict) and profiles:
        lines.append("Profile results:")
        for profile in sorted(profiles):
            row = profiles.get(profile)
            if not isinstance(row, dict):
                continue
            lines.append(f"- {profile}: {row.get('passed', 0)}/{row.get('total', 0)}")
    categories = summary.get("categories")
    if isinstance(categories, dict) and categories:
        lines.append("Category results:")
        for category in sorted(categories):
            row = categories.get(category)
            if not isinstance(row, dict):
                continue
            lines.append(f"- {category}: {row.get('passed', 0)}/{row.get('total', 0)}")
    lines.append("Case results:")
    for case in summary.get("cases", []):
        if not isinstance(case, dict):
            continue
        category = str(case.get("category") or "unknown")
        run_profile = str(case.get("run_profile") or "deterministic")
        agents = case.get("expected_agents")
        agent_suffix = ""
        if isinstance(agents, list) and agents:
            agent_suffix = f" agents={','.join(str(agent) for agent in agents)}"
        lines.append(f"- {case.get('status', 'FAIL')} [{category}/{run_profile}] {case.get('title', 'unnamed')}{agent_suffix}")
    return "\n".join(lines)


def _collect_playwright_specs(suites: object) -> list[dict[str, object]]:
    specs: list[dict[str, object]] = []
    if not isinstance(suites, list):
        return specs
    for suite in suites:
        if not isinstance(suite, dict):
            continue
        specs.extend(item for item in suite.get("specs", []) if isinstance(item, dict))
        specs.extend(_collect_playwright_specs(suite.get("suites", [])))
    return specs


def _playwright_spec(base_url: str, cases: list[dict[str, object]], keep: bool) -> str:
    serializable_cases = []
    for case in cases:
        serializable = {**case, "attachments": [str(path) for path in case["attachments"]]}  # type: ignore[index]
        serializable_cases.append(serializable)
    return textwrap.dedent(
        f"""
        const {{ test, expect }} = require('@playwright/test');
        const fs = require('node:fs');

        const baseUrl = {json.dumps(base_url)};
        const keep = {json.dumps(keep)};
        const cases = {json.dumps(serializable_cases, ensure_ascii=False)};

        test.describe('ForgeFlag browser player benchmark', () => {{
          for (const ctfCase of cases) {{
            test(ctfCase.challenge_id, async ({{ page }}) => {{
              await page.goto(baseUrl);
              await page.locator('#challengeId').fill(ctfCase.challenge_id);
              await page.locator('#category').selectOption(ctfCase.category);
              await page.locator('#title').fill(ctfCase.title);
              await page.locator('#target').fill(ctfCase.target || '');
              await page.locator('#description').fill(ctfCase.description || '');
              if (ctfCase.attachments.length) {{
                await page.locator('#attachments').setInputFiles(ctfCase.attachments);
              }}
              await page.getByRole('button', {{ name: '保存题目' }}).click();
              await expect(page.locator('#status')).toContainText('题目已保存');
              await expect(page.locator('#challengeList')).toContainText(ctfCase.challenge_id);

              if (ctfCase.llm_enabled) {{
                await page.locator('#llmEnabled').check();
              }} else {{
                await page.locator('#llmEnabled').uncheck();
              }}
              if (ctfCase.active_probe) {{
                await page.locator('#activeProbe').check();
              }} else {{
                await page.locator('#activeProbe').uncheck();
              }}

              await page.getByRole('button', {{ name: '运行选中题目' }}).click();
              await expect(page.locator('#status')).toContainText('运行完成', {{ timeout: 60000 }});
              await page.getByRole('button', {{ name: 'Summary' }}).click();
              await expect(page.locator('#output')).toContainText(ctfCase.expected_flag, {{ timeout: 10000 }});
              await page.getByRole('button', {{ name: 'Write-up' }}).click();
              await expect(page.locator('#output')).toContainText('解题思路');
              await expect(page.locator('#output')).toContainText('复现步骤');
              await expect(page.locator('#output')).toContainText(ctfCase.expected_flag);
              await page.getByRole('button', {{ name: 'Agent' }}).click();
              await expect(page.locator('#output')).toContainText('Agent 身份配置');
              for (const agentName of ctfCase.expected_agents) {{
                await expect(page.locator('#output')).toContainText(agentName);
              }}

              if (!keep) {{
                page.on('dialog', dialog => dialog.accept());
                await page.getByRole('button', {{ name: '删除选中' }}).click();
                await expect(page.locator('#status')).toContainText(`已删除：${{ctfCase.challenge_id}}`);
              }}
            }});
          }}
        }});
        """
    ).strip() + "\n"


def write_http_pcap(path: Path, payload: bytes) -> None:
    packet = ethernet_frame(ipv4_packet(tcp_segment(payload)))
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        handle.write(struct.pack("<IIII", int(time.time()), 0, len(packet), len(packet)))
        handle.write(packet)


def ethernet_frame(payload: bytes) -> bytes:
    return b"\xaa\xaa\xaa\xaa\xaa\xaa" + b"\xbb\xbb\xbb\xbb\xbb\xbb" + b"\x08\x00" + payload


def ipv4_packet(payload: bytes) -> bytes:
    src = socket.inet_aton("10.0.0.2")
    dst = socket.inet_aton("10.0.0.3")
    total_length = 20 + len(payload)
    header = struct.pack("!BBHHHBBH4s4s", 0x45, 0, total_length, 1, 0x4000, 64, 6, 0, src, dst)
    checksum = internet_checksum(header)
    return struct.pack("!BBHHHBBH4s4s", 0x45, 0, total_length, 1, 0x4000, 64, 6, checksum, src, dst) + payload


def tcp_segment(payload: bytes) -> bytes:
    data_offset_and_flags = (5 << 12) | 0x18
    return struct.pack("!HHIIHHHH", 4444, 80, 1, 1, data_offset_and_flags, 8192, 0, 0) + payload


def internet_checksum(data: bytes) -> int:
    if len(data) % 2:
        data += b"\x00"
    total = sum(struct.unpack("!%dH" % (len(data) // 2), data))
    while total >> 16:
        total = (total & 0xFFFF) + (total >> 16)
    return (~total) & 0xFFFF


if __name__ == "__main__":
    raise SystemExit(main())
