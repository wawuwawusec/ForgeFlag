#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import json
from pathlib import Path
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


ROOT = Path(__file__).resolve().parents[1]
WORKDIR = ROOT / ".forgeflag" / "hard-corpus"


def main() -> int:
    parser = argparse.ArgumentParser(description="Run hard public-CTF-pattern cases through ForgeFlag Web.")
    parser.add_argument("--url", default="http://127.0.0.1:8080", help="ForgeFlag Web UI base URL")
    parser.add_argument("--list", action="store_true", help="List hard corpus cases without running them")
    parser.add_argument("--keep", action="store_true", help="Keep generated challenges in the Web notebook after running")
    parser.add_argument("--strict", action="store_true", help="Exit non-zero when any hard benchmark score is incomplete")
    parser.add_argument("--llm", action="store_true", help="Enable configured LLM planning for benchmark runs")
    args = parser.parse_args()

    WORKDIR.mkdir(parents=True, exist_ok=True)
    fixtures = build_fixtures()
    cases = hard_cases(fixtures)
    if args.list:
        print(json.dumps({"cases": [_case_listing(case) for case in cases]}, indent=2, ensure_ascii=False))
        return 0

    web_server = start_web_server()
    rows: list[dict[str, object]] = []
    try:
        for case in cases:
            delete_challenge(args.url, str(case["challenge_id"]))
            create_challenge(args.url, case)
            summary = run_challenge(args.url, case, llm_enabled=args.llm)
            findings = get_json(args.url, f"/api/challenges/{case['challenge_id']}/findings")
            observations = get_json(args.url, f"/api/challenges/{case['challenge_id']}/observations")
            report = get_json(args.url, f"/api/challenges/{case['challenge_id']}/report")
            rows.append(score_case(case, summary, findings, observations, report))
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        if args.strict and any(not row["ok"] for row in rows):
            return 1
        return 0
    finally:
        web_server.shutdown()
        web_server.server_close()
        if not args.keep:
            for case in cases:
                delete_challenge(args.url, str(case["challenge_id"]))


def build_fixtures() -> dict[str, Path]:
    web_source = WORKDIR / "flag-command-source.txt"
    web_source.write_text(
        "HTB Cyber Apocalypse Flag Command pattern: browser code asks /api/options for hidden commands.\n",
        encoding="utf-8",
    )

    crypto_ctr = WORKDIR / "aes-ctr-reuse.txt"
    crypto_ctr.write_text(
        "\n".join(
            [
                "DownUnderCTF-style hard crypto pattern.",
                "cipher = AES.new(key, AES.MODE_CTR, nonce=b'fixed')",
                "c1 = 4f7a0b1a...",
                "c2 = 4c651d09...",
                "Two messages were encrypted under the same CTR nonce.",
                "Goal: detect keystream reuse and request a crib/XOR workflow, not guess the flag.",
            ]
        ),
        encoding="utf-8",
    )

    poly1305 = WORKDIR / "poly1305-otm.txt"
    poly1305.write_text(
        "Poly1305 one-time MAC key was reused across messages. Recovering the key requires algebra over the MAC equations.\n",
        encoding="utf-8",
    )

    traffic = WORKDIR / "dns-split-base32.pcap"
    write_dns_pcap(traffic, "flag{hard_dns_split}")

    http_stream = WORKDIR / "http-stream-follow.pcap"
    write_http_pcap(
        http_stream,
        b"POST /submit HTTP/1.1\r\nHost: hard-stream.test\r\nContent-Length: 25\r\n\r\nflag{hard_tcp_stream_path}\n",
    )

    http_object = WORKDIR / "http-object-export.pcap"
    write_http_response_pcap(
        http_object,
        b"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 30\r\n\r\nflag{hard_http_object_export}\n",
    )

    eml = WORKDIR / "powershell-email.eml"
    encoded = base64.b64encode(b"powershell -enc ZmxhZ3toYXJkX21haWxfdHJpYWdlfQ==").decode("ascii")
    eml.write_text(
        f"Subject: urgent\nFrom: attacker@example.test\n\nSuspicious attachment command:\n{encoded}\n",
        encoding="utf-8",
    )

    reverse_source = WORKDIR / "packed-away-sample.c"
    reverse_source.write_text(
        '#include <stdio.h>\n'
        'const char *marker = "UPX! packed binary marker; unpack before decompilation";\n'
        'int main(void) { puts(marker); return 0; }\n',
        encoding="utf-8",
    )
    reverse_bin = WORKDIR / "packed-away-sample"
    compile_c(reverse_source, reverse_bin)

    pwn_source = WORKDIR / "format-string.c"
    pwn_source.write_text(
        "#include <stdio.h>\n"
        "int main(void) { char name[128]; fgets(name, sizeof(name), stdin); printf(name); return 0; }\n",
        encoding="utf-8",
    )

    pickle = WORKDIR / "pickle-sandbox.py"
    pickle.write_text(
        "import pickle\nBLACKLIST = ['os', 'system', 'eval']\nblob = input('pickle> ')\npickle.loads(bytes.fromhex(blob))\n",
        encoding="utf-8",
    )

    java_reverse = WORKDIR / "dark-portal-notes.txt"
    java_reverse.write_text(
        "Real World CTF Dark Portal pattern: web LFI downloads ROOT.war, then Java handlers need static analysis passes.\n",
        encoding="utf-8",
    )

    return {
        "web_source": web_source,
        "crypto_ctr": crypto_ctr,
        "poly1305": poly1305,
        "traffic": traffic,
        "http_stream": http_stream,
        "http_object": http_object,
        "eml": eml,
        "reverse": reverse_bin,
        "pwn_source": pwn_source,
        "pickle": pickle,
        "java_reverse": java_reverse,
    }


