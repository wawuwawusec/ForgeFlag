#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import binascii
import json
from pathlib import Path
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


ROOT = Path(__file__).resolve().parents[1]
WORKDIR = ROOT / ".forgeflag" / "hard-corpus"


def main() -> int:
    parser = argparse.ArgumentParser(description="Run hard public-CTF-pattern cases through ForgeFlag Web.")
    parser.add_argument("--url", default="http://127.0.0.1:8080", help="ForgeFlag Web UI base URL")
    parser.add_argument("--list", action="store_true", help="List hard corpus cases without running them")
    parser.add_argument("--keep", action="store_true", help="Keep generated challenges in the Web notebook after running")
    parser.add_argument("--strict", action="store_true", help="Exit non-zero when any hard benchmark score is incomplete")
    parser.add_argument("--llm", action="store_true", help="Enable configured LLM planning for benchmark runs")
    args = parser.parse_args()

    WORKDIR.mkdir(parents=True, exist_ok=True)
    fixtures = build_fixtures()
    cases = hard_cases(fixtures)
    if args.list:
        print(json.dumps({"cases": [_case_listing(case) for case in cases]}, indent=2, ensure_ascii=False))
        return 0

    web_server = start_web_server()
    rows: list[dict[str, object]] = []
    try:
        for case in cases:
            delete_challenge(args.url, str(case["challenge_id"]))
            create_challenge(args.url, case)
            summary = run_challenge(args.url, case, llm_enabled=args.llm)
            findings = get_json(args.url, f"/api/challenges/{case['challenge_id']}/findings")
            observations = get_json(args.url, f"/api/challenges/{case['challenge_id']}/observations")
            report = get_json(args.url, f"/api/challenges/{case['challenge_id']}/report")
            rows.append(score_case(case, summary, findings, observations, report))
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        if args.strict and any(not row["ok"] for row in rows):
            return 1
        return 0
    finally:
        web_server.shutdown()
        web_server.server_close()
        if not args.keep:
            for case in cases:
                delete_challenge(args.url, str(case["challenge_id"]))


def build_fixtures() -> dict[str, Path]:
    web_source = WORKDIR / "flag-command-source.txt"
    web_source.write_text(
        "HTB Cyber Apocalypse Flag Command pattern: browser code asks /api/options for hidden commands.\n",
        encoding="utf-8",
    )

    web_route_source = WORKDIR / "web-source-routes.py"
    web_route_source.write_text(
        "from flask import Flask, request, session\n"
        "import jwt, requests\n"
        "app = Flask(__name__)\n"
        "app.config['SECRET_KEY'] = 'ctf-dev-secret'\n"
        "@app.route('/api/options')\n"
        "def options(): return {'commands': ['status', 'flag']}\n"
        "@app.route('/fetch')\n"
        "def fetch(): return requests.get(request.args['url']).text\n"
        "@app.route('/download')\n"
        "def download(): return open(request.args['file']).read()\n"
        "def auth(token): return jwt.decode(token, options={'verify_signature': False})\n",
        encoding="utf-8",
    )

    crypto_ctr = WORKDIR / "aes-ctr-reuse.txt"
    crypto_ctr.write_text(
        "\n".join(
            [
                "DownUnderCTF-style hard crypto pattern.",
                "cipher = AES.new(key, AES.MODE_CTR, nonce=b'fixed')",
                "c1 = 4f7a0b1a...",
                "c2 = 4c651d09...",
                "Two messages were encrypted under the same CTR nonce.",
                "Goal: detect keystream reuse and request a crib/XOR workflow, not guess the flag.",
            ]
        ),
        encoding="utf-8",
    )

    crypto_gcm = WORKDIR / "aes-gcm-reuse.txt"
    crypto_gcm.write_text(
        "\n".join(
            [
                "HackTricks/CryptoHack-style AEAD misuse pattern.",
                "cipher = AES.new(key, AES.MODE_GCM, nonce=nonce)",
                "The same nonce was reused for two ciphertext/tag pairs.",
                "c1 = 0011223344556677, tag1 = 8899aabbccddeeff0011223344556677",
                "c2 = 1021324354657687, tag2 = 9988ffeeddccbbaa7766554433221100",
                "Goal: identify GHASH algebra and forbidden attack workflow before guessing a flag.",
            ]
        ),
        encoding="utf-8",
    )

    poly1305 = WORKDIR / "poly1305-otm.txt"
    poly1305.write_text(
        "Poly1305 one-time MAC key was reused across messages. Recovering the key requires algebra over the MAC equations.\n",
        encoding="utf-8",
    )

    rsa_low_exponent = WORKDIR / "rsa-low-exponent.txt"
    rsa_message = int.from_bytes(b"flag{hard_rsa_low_exponent}", "big")
    rsa_e = 3
    rsa_n = 2**521 - 1
    rsa_c = rsa_message**rsa_e
    rsa_low_exponent.write_text(
        f"RSA low public exponent challenge with no padding.\nn = {rsa_n}\ne = {rsa_e}\nc = {rsa_c}\n",
        encoding="utf-8",
    )

    rsa_modular_low_exponent = WORKDIR / "rsa-modular-low-exponent.py"
    modular_message = int.from_bytes(b"flag{hard_rsa_modular_low}", "big")
    modular_e = 7
    modular_n = 2**521 - 1
    modular_k = 13
    modular_c = modular_message**modular_e - modular_n * modular_k
    rsa_modular_low_exponent.write_text(
        "from gmpy2 import iroot\n"
        "from Crypto.Util.number import long_to_bytes\n"
        f"n = {modular_n}\n"
        f"c = {modular_c}\n"
        "for i in range(10000):\n"
        "    root, exact = iroot(c+n*i, 7)\n"
        "    if exact:\n"
        "        print(i)\n"
        "        print(long_to_bytes(root))\n",
        encoding="utf-8",
    )

    rsa_prime_modulus = WORKDIR / "rsa-prime-modulus.txt"
    prime_n = 2**521 - 1
    prime_e = 65537
    prime_message = int.from_bytes(b"flag{hard_rsa_prime_modulus}", "big")
    prime_c = pow(prime_message, prime_e, prime_n)
    rsa_prime_modulus.write_text(
        "RSA prime modulus challenge: n is prime, so phi is n - 1.\n"
        f"n = {prime_n}\ne = {prime_e}\nc = {prime_c}\n",
        encoding="utf-8",
    )

    rsa_fermat = WORKDIR / "rsa-fermat.txt"
    fermat_p = 170141183460469231731687303715884105727
    fermat_q = 170141183460469231731687303715884105757
    fermat_n = fermat_p * fermat_q
    fermat_e = 65537
    fermat_message = int.from_bytes(b"flag{hard_rsa_fermat}", "big")
    fermat_c = pow(fermat_message, fermat_e, fermat_n)
    rsa_fermat.write_text(
        "RSA close-prime challenge: p and q are close enough for Fermat factorization.\n"
        f"n = {fermat_n}\ne = {fermat_e}\nc = {fermat_c}\n",
        encoding="utf-8",
    )

    rsa_common_modulus = WORKDIR / "rsa-common-modulus.txt"
    common_message = int.from_bytes(b"flag{hard_rsa_common_modulus}", "big")
    common_n = 2**521 - 1
    common_e1 = 17
    common_e2 = 65537
    common_c1 = pow(common_message, common_e1, common_n)
    common_c2 = pow(common_message, common_e2, common_n)
    rsa_common_modulus.write_text(
        "RSA common modulus challenge: the same plaintext was encrypted with the same n and two coprime public exponents.\n"
        f"n = {common_n}\ne1 = {common_e1}\ne2 = {common_e2}\nc1 = {common_c1}\nc2 = {common_c2}\n",
        encoding="utf-8",
    )

    rsa_shared_prime = WORKDIR / "rsa-shared-prime.txt"
    shared_p = 2**127 - 1
    shared_q1 = 2**89 - 1
    shared_q2 = 2**107 - 1
    shared_n1 = shared_p * shared_q1
    shared_n2 = shared_p * shared_q2
    shared_e = 65537
    shared_message = int.from_bytes(b"flag{hard_rsa_shared_prime}", "big")
    shared_c1 = pow(shared_message, shared_e, shared_n1)
    rsa_shared_prime.write_text(
        "RSA shared-prime challenge: two public moduli accidentally share one prime factor.\n"
        f"n1 = {shared_n1}\nn2 = {shared_n2}\ne = {shared_e}\nc1 = {shared_c1}\n",
        encoding="utf-8",
    )

    rsa_broadcast = WORKDIR / "rsa-broadcast.txt"
    broadcast_message = int.from_bytes(b"flag{hard_rsa_broadcast}", "big")
    broadcast_e = 3
    broadcast_n1 = 2**521 - 1
    broadcast_n2 = 2**607 - 1
    broadcast_n3 = 2**431 - 1
    broadcast_c1 = pow(broadcast_message, broadcast_e, broadcast_n1)
    broadcast_c2 = pow(broadcast_message, broadcast_e, broadcast_n2)
    broadcast_c3 = pow(broadcast_message, broadcast_e, broadcast_n3)
    rsa_broadcast.write_text(
        "RSA broadcast challenge: the same plaintext was sent to three pairwise-coprime moduli with e=3 and no padding.\n"
        f"n1 = {broadcast_n1}\nn2 = {broadcast_n2}\nn3 = {broadcast_n3}\ne = {broadcast_e}\n"
        f"c1 = {broadcast_c1}\nc2 = {broadcast_c2}\nc3 = {broadcast_c3}\n",
        encoding="utf-8",
