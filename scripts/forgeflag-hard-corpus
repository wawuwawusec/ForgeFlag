def _case_listing(case: dict[str, object]) -> dict[str, object]:
    return {
        key: case[key]
        for key in ("challenge_id", "category", "difficulty", "title", "expected_flag", "required_evidence", "source_url")
    }


def score_case(
    case: dict[str, object],
    summary: dict[str, object],
    findings: object,
    observations: object,
    report: object,
) -> dict[str, object]:
    haystack = json.dumps({"summary": summary, "findings": findings, "observations": observations, "report": report}, ensure_ascii=False)
    accepted = summary.get("accepted_flags", []) if isinstance(summary, dict) else []
    expected_flag = case.get("expected_flag")
    flag_ok = expected_flag is None or expected_flag in accepted
    required = [str(item) for item in case["required_evidence"]]
    matched = [item for item in required if item.lower() in haystack.lower()]
    missing = [item for item in required if item not in matched]
    score = (1 if flag_ok else 0) + len(matched)
    max_score = 1 + len(required)
    return {
        "challenge_id": case["challenge_id"],
        "category": case["category"],
        "difficulty": case["difficulty"],
        "status": summary.get("status") if isinstance(summary, dict) else "unknown",
        "expected_flag": expected_flag,
        "accepted_flags": accepted,
        "flag_ok": flag_ok,
        "matched_evidence": matched,
        "missing_evidence": missing,
        "score": score,
        "max_score": max_score,
        "ok": score == max_score,
        "source_url": case["source_url"],
        "improvement_hint": case["improvement_hint"],
    }


class HardWebHandler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if self.path == "/api/options":
            body = json.dumps(
                {
                    "commands": ["look", "status", "blip-blop"],
                    "hidden_api": "flag{hard_web_option_leak}",
                }
            ).encode("utf-8")
            self.send_response(200)
            self.send_header("content-type", "application/json")
        elif self.path == "/portal":
            body = b"Portal accepts file:// URLs. Try reading /opt/tomcat/webapps/ROOT.war for Java handler analysis."
            self.send_response(200)
            self.send_header("content-type", "text/plain")
        else:
            body = b'<!doctype html><title>Flag Command</title><script>fetch("/api/options")</script><p>start</p>'
            self.send_response(200)
            self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        return


def start_web_server() -> ThreadingHTTPServer:
    server = ThreadingHTTPServer(("127.0.0.1", 18093), HardWebHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def create_challenge(base_url: str, case: dict[str, object]) -> None:
    payload = {
        "challenge_id": case["challenge_id"],
        "category": case["category"],
        "title": case["title"],
        "target": case.get("target", ""),
        "description": case["description"],
        "tags": f"hard-corpus,{case['difficulty']},{case['category']}",
        "attachments": [
            {
                "name": path.name,
                "content_base64": base64.b64encode(path.read_bytes()).decode("ascii"),
            }
            for path in case.get("attachments", [])
        ],
    }
    post_json(base_url, "/api/challenges", payload)


def run_challenge(base_url: str, case: dict[str, object], llm_enabled: bool) -> dict[str, object]:
    return post_json(
        base_url,
        f"/api/challenges/{case['challenge_id']}/run",
        {
            "active_probe": case["active_probe"],
            "allowed_hosts": "127.0.0.1,localhost",
            "llm_enabled": llm_enabled,
            "llm_provider": "zhipu" if llm_enabled else "disabled",
        },
    )


def delete_challenge(base_url: str, challenge_id: str) -> None:
    request = urllib.request.Request(base_url.rstrip("/") + f"/api/challenges/{challenge_id}", method="DELETE")
    try:
        with urllib.request.urlopen(request, timeout=20):
            return
    except (urllib.error.HTTPError, urllib.error.URLError):
        return


def post_json(base_url: str, path: str, payload: dict[str, object]) -> dict[str, object]:
    request = urllib.request.Request(
        base_url.rstrip("/") + path,
        data=json.dumps(payload).encode("utf-8"),
        headers={"content-type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.loads(response.read().decode("utf-8"))


def get_json(base_url: str, path: str) -> dict[str, object] | list[dict[str, object]]:
    with urllib.request.urlopen(base_url.rstrip("/") + path, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def compile_c(source: Path, output: Path) -> None:
    subprocess.run(["clang", str(source), "-o", str(output)], check=True)


def write_png_text(path: Path, text: str) -> None:
    def chunk(kind: bytes, body: bytes) -> bytes:
        crc = binascii.crc32(kind + body) & 0xFFFFFFFF
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", crc)

    ihdr = struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)
    row = b"\x00" + bytes([255, 255, 255, 255])
    path.write_bytes(
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", ihdr)
        + chunk(b"tEXt", b"Comment\x00" + text.encode("latin-1", errors="replace"))
        + chunk(b"IDAT", zlib.compress(row))
        + chunk(b"IEND", b"")
    )


def write_dns_pcap(path: Path, flag: str) -> None:
    encoded = base64.b32encode(flag.encode("utf-8")).decode("ascii").rstrip("=").lower()
    query = ".".join([encoded[:18], encoded[18:36], encoded[36:]]) + ".exfil.test"
    payload = dns_query(query)
    packet = ethernet_frame(ipv4_packet(udp_datagram(payload)))
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        ts = int(time.time())
        handle.write(struct.pack("<IIII", ts, 0, len(packet), len(packet)))
        handle.write(packet)


def write_http_pcap(path: Path, payload: bytes) -> None:
    packet = ethernet_frame(ipv4_packet(tcp_segment(payload), protocol=6))
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        handle.write(struct.pack("<IIII", int(time.time()), 0, len(packet), len(packet)))
        handle.write(packet)


def write_http_response_pcap(path: Path, payload: bytes) -> None:
    packet = ethernet_frame(ipv4_packet(tcp_response_segment(payload), protocol=6))
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        handle.write(struct.pack("<IIII", int(time.time()), 0, len(packet), len(packet)))
        handle.write(packet)


def write_smtp_pcap(path: Path, payload: bytes) -> None:
    packet = ethernet_frame(ipv4_packet(tcp_custom_segment(payload, src_port=53333, dst_port=25), protocol=6))
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        handle.write(struct.pack("<IIII", int(time.time()), 0, len(packet), len(packet)))
        handle.write(packet)


def dns_query(name: str) -> bytes:
    labels = b"".join(bytes([len(part)]) + part.encode("ascii") for part in name.split(".") if part)
    return struct.pack("!HHHHHH", 0x4242, 0x0100, 1, 0, 0, 0) + labels + b"\x00" + struct.pack("!HH", 1, 1)


def udp_datagram(payload: bytes) -> bytes:
    length = 8 + len(payload)
    return struct.pack("!HHHH", 53000, 53, length, 0) + payload


def ipv4_packet(payload: bytes, protocol: int = 17) -> bytes:
    src = socket.inet_aton("10.10.10.2")
    dst = socket.inet_aton("8.8.8.8")
    total_length = 20 + len(payload)
    header = struct.pack("!BBHHHBBH4s4s", 0x45, 0, total_length, 1, 0x4000, 64, protocol, 0, src, dst)
    checksum = internet_checksum(header)
    return struct.pack("!BBHHHBBH4s4s", 0x45, 0, total_length, 1, 0x4000, 64, protocol, checksum, src, dst) + payload


def tcp_segment(payload: bytes) -> bytes:
    data_offset_and_flags = (5 << 12) | 0x18
    return struct.pack("!HHIIHHHH", 4444, 80, 1, 1, data_offset_and_flags, 8192, 0, 0) + payload


def tcp_response_segment(payload: bytes) -> bytes:
    data_offset_and_flags = (5 << 12) | 0x18
    return struct.pack("!HHIIHHHH", 80, 4444, 1, 1, data_offset_and_flags, 8192, 0, 0) + payload


def tcp_custom_segment(payload: bytes, src_port: int, dst_port: int) -> bytes:
    data_offset_and_flags = (5 << 12) | 0x18
    return struct.pack("!HHIIHHHH", src_port, dst_port, 1, 1, data_offset_and_flags, 8192, 0, 0) + payload


def ethernet_frame(payload: bytes) -> bytes:
    return b"\xaa\xaa\xaa\xaa\xaa\xaa" + b"\xbb\xbb\xbb\xbb\xbb\xbb" + b"\x08\x00" + payload


def internet_checksum(data: bytes) -> int:
    if len(data) % 2:
        data += b"\x00"
    total = sum(struct.unpack("!%dH" % (len(data) // 2), data))
    while total >> 16:
        total = (total & 0xFFFF) + (total >> 16)
    return (~total) & 0xFFFF


if __name__ == "__main__":
    raise SystemExit(main())
