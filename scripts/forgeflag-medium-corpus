def _case_listing(case: dict[str, object]) -> dict[str, object]:
    return {
        key: case[key]
        for key in ("challenge_id", "category", "difficulty", "title", "expected_flag", "source_url")
    }


class MediumWebHandler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if self.path == "/flag":
            body = b"flag{medium_web_link}"
        else:
            body = b'<!doctype html><title>Medium Web</title><a href="/flag">system status</a>'
        self.send_response(200)
        self.send_header("content-type", "text/html; charset=utf-8")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        return


def start_web_server() -> ThreadingHTTPServer:
    server = ThreadingHTTPServer(("127.0.0.1", 18091), MediumWebHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def start_tcp_server(payload: bytes) -> socket.socket:
    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind(("127.0.0.1", 18092))
    server.listen(5)

    def serve() -> None:
        while True:
            try:
                conn, _ = server.accept()
            except OSError:
                break
            with conn:
                conn.sendall(payload)

    threading.Thread(target=serve, daemon=True).start()
    return server


def write_zip(path: Path, entries: dict[str, str]) -> None:
    import zipfile

    with zipfile.ZipFile(path, "w") as zf:
        for name, value in entries.items():
            zf.writestr(name, value)


def compile_c(source: Path, output: Path) -> None:
    subprocess.run(["clang", str(source), "-o", str(output)], check=True)


def create_challenge(base_url: str, case: dict[str, object]) -> None:
    payload = {
        "challenge_id": case["challenge_id"],
        "category": case["category"],
        "title": case["title"],
        "target": case.get("target", ""),
        "description": case["description"],
        "tags": f"medium-corpus,{case['difficulty']},{case['category']}",
        "attachments": [
            {
                "name": path.name,
                "content_base64": base64.b64encode(path.read_bytes()).decode("ascii"),
            }
            for path in case["attachments"]
        ],
    }
    post_json(base_url, "/api/challenges", payload)


def run_challenge(base_url: str, case: dict[str, object]) -> dict[str, object]:
    return post_json(
        base_url,
        f"/api/challenges/{case['challenge_id']}/run",
        {
            "active_probe": case["active_probe"],
            "allowed_hosts": "127.0.0.1,localhost",
            "llm_enabled": False,
            "llm_provider": "disabled",
        },
    )


def delete_challenge(base_url: str, challenge_id: str) -> None:
    request = urllib.request.Request(base_url.rstrip("/") + f"/api/challenges/{challenge_id}", method="DELETE")
    try:
        with urllib.request.urlopen(request, timeout=20):
            return
    except urllib.error.HTTPError:
        return
    except urllib.error.URLError:
        return


def post_json(base_url: str, path: str, payload: dict[str, object]) -> dict[str, object]:
    request = urllib.request.Request(
        base_url.rstrip("/") + path,
        data=json.dumps(payload).encode("utf-8"),
        headers={"content-type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=45) as response:
        return json.loads(response.read().decode("utf-8"))


def get_json(base_url: str, path: str) -> dict[str, object] | list[dict[str, object]]:
    with urllib.request.urlopen(base_url.rstrip("/") + path, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def write_dns_pcap(path: Path, flag: str) -> None:
    query = flag.encode("utf-8").hex() + ".exfil.test"
    payload = dns_query(query)
    packet = ethernet_frame(ipv4_packet(udp_datagram(payload)))
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        ts = int(time.time())
        handle.write(struct.pack("<IIII", ts, 0, len(packet), len(packet)))
        handle.write(packet)


def dns_query(name: str) -> bytes:
    labels = b"".join(bytes([len(part)]) + part.encode("ascii") for part in name.split("."))
    return struct.pack("!HHHHHH", 0x1337, 0x0100, 1, 0, 0, 0) + labels + b"\x00" + struct.pack("!HH", 1, 1)


def udp_datagram(payload: bytes) -> bytes:
    length = 8 + len(payload)
    return struct.pack("!HHHH", 53000, 53, length, 0) + payload


def ipv4_packet(payload: bytes) -> bytes:
    src = socket.inet_aton("10.10.10.2")
    dst = socket.inet_aton("8.8.8.8")
    total_length = 20 + len(payload)
    header = struct.pack("!BBHHHBBH4s4s", 0x45, 0, total_length, 1, 0x4000, 64, 17, 0, src, dst)
    checksum = internet_checksum(header)
    return struct.pack("!BBHHHBBH4s4s", 0x45, 0, total_length, 1, 0x4000, 64, 17, checksum, src, dst) + payload


def ethernet_frame(payload: bytes) -> bytes:
    return b"\xaa\xaa\xaa\xaa\xaa\xaa" + b"\xbb\xbb\xbb\xbb\xbb\xbb" + b"\x08\x00" + payload


def internet_checksum(data: bytes) -> int:
    if len(data) % 2:
        data += b"\x00"
    total = sum(struct.unpack("!%dH" % (len(data) // 2), data))
    while total >> 16:
        total = (total & 0xFFFF) + (total >> 16)
    return (~total) & 0xFFFF


if __name__ == "__main__":
    raise SystemExit(main())
