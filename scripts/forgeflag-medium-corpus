#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import json
from pathlib import Path
import socket
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


ROOT = Path(__file__).resolve().parents[1]
WORKDIR = ROOT / ".forgeflag" / "medium-corpus"


def main() -> int:
    parser = argparse.ArgumentParser(description="Run medium-difficulty public-CTF-pattern cases through ForgeFlag Web.")
    parser.add_argument("--url", default="http://127.0.0.1:8080", help="ForgeFlag Web UI base URL")
    parser.add_argument("--list", action="store_true", help="List corpus cases without running them")
    parser.add_argument("--keep", action="store_true", help="Keep generated challenges in the Web notebook after running")
    args = parser.parse_args()

    WORKDIR.mkdir(parents=True, exist_ok=True)
    fixtures = build_fixtures()
    cases = corpus_cases(fixtures)
    if args.list:
        print(json.dumps({"cases": [_case_listing(case) for case in cases]}, indent=2, ensure_ascii=False))
        return 0

    web_server = start_web_server()
    tcp_server = start_tcp_server(b"Welcome to the service\nflag{medium_pwn_banner}\n")
    rows: list[dict[str, object]] = []
    try:
        for case in cases:
            delete_challenge(args.url, str(case["challenge_id"]))
            create_challenge(args.url, case)
            summary = run_challenge(args.url, case)
            findings = get_json(args.url, f"/api/challenges/{case['challenge_id']}/findings")
            accepted = summary.get("accepted_flags", [])
            ok = case["expected_flag"] in accepted
            rows.append(
                {
                    "challenge_id": case["challenge_id"],
                    "category": case["category"],
                    "difficulty": case["difficulty"],
                    "status": summary.get("status"),
                    "expected": case["expected_flag"],
                    "accepted_flags": accepted,
                    "ok": ok,
                    "source_url": case["source_url"],
                    "findings": [item.get("finding") for item in findings],
                }
            )
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        failed = [row for row in rows if not row["ok"]]
        return 1 if failed else 0
    finally:
        web_server.shutdown()
        web_server.server_close()
        tcp_server.close()
        if not args.keep:
            for case in cases:
                delete_challenge(args.url, str(case["challenge_id"]))


def build_fixtures() -> dict[str, Path]:
    crypto = WORKDIR / "rsa-known-factors.txt"
    p = 2**521 - 1
    q = 2**127 - 1
    n = p * q
    e = 65537
    message = int.from_bytes(b"flag{medium_rsa_known_factors}", "big")
    c = pow(message, e, n)
    crypto.write_text(f"n = {n}\ne = {e}\nc = {c}\np = {p}\nq = {q}\n", encoding="utf-8")

    misc_zip = WORKDIR / "misc-nested.zip"
    write_zip(misc_zip, {"docs/readme.txt": "try the secret entry", "secret/flag.txt": "flag{medium_archive_misc}"})

    forensics_zip = WORKDIR / "forensics-bundle.zip"
    write_zip(forensics_zip, {"evidence/log.txt": "routine log", "flag.txt": "flag{medium_forensics_archive}"})

    traffic = WORKDIR / "dns-exfil.pcap"
    write_dns_pcap(traffic, "flag{medium_dns_exfil}")

    reverse_source = WORKDIR / "reverse-medium.c"
    reverse_source.write_text(
        '#include <stdio.h>\n'
        'const char *hint = "static triage still matters";\n'
        'const char *flag = "flag{medium_reverse_static}";\n'
        'int main(void) { puts(hint); return flag[0] == 0; }\n',
        encoding="utf-8",
    )
    reverse_bin = WORKDIR / "reverse-medium"
    compile_c(reverse_source, reverse_bin)

    return {
        "crypto": crypto,
        "misc_zip": misc_zip,
        "forensics_zip": forensics_zip,
        "traffic": traffic,
        "reverse": reverse_bin,
    }


