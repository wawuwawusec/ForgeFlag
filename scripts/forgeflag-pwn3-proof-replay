#!/usr/bin/env python3
from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from forgeflag.notebook import SQLiteNotebook
from forgeflag.pwn_replay import record_pwn_replay_proof


DEFAULT_CHALLENGE_ID = "pwn-20260702-152927-2016-cctf-pwn3"
DEFAULT_DB = Path(".forgeflag/notebook.sqlite")
DEFAULT_IMAGE = "forgeflag-i386-pwnlab:latest"
DEFAULT_TEST_FLAG = "flag{forgeflag_local_pwn3_replay}"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Replay local pwn3 proof and write ForgeFlag proof status.")
    parser.add_argument("--challenge-id", default=DEFAULT_CHALLENGE_ID)
    parser.add_argument("--db", default=str(DEFAULT_DB))
    parser.add_argument("--image", default=DEFAULT_IMAGE)
    parser.add_argument("--test-flag", default=DEFAULT_TEST_FLAG)
    parser.add_argument("--no-record", action="store_true", help="run replay only; do not update the notebook")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    root = Path.cwd()
    command = [
        "docker",
        "run",
        "--rm",
        "-v",
        f"{root}:/workspace",
        "-w",
        "/workspace",
        args.image,
        "python3",
        "scripts/solve_pwn3_local_replay.py",
    ]
    completed = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=False,
        stdin=subprocess.DEVNULL,
        timeout=20,
    )
    transcript = (completed.stdout or "") + (completed.stderr or "")
    print(transcript, end="")
    if completed.returncode != 0:
        raise SystemExit(completed.returncode)
    if f"PROOF_OK {args.test_flag}" not in transcript:
        raise SystemExit(f"proof marker missing for {args.test_flag}")
    if args.no_record:
        return 0

    summary = record_pwn_replay_proof(
        SQLiteNotebook(args.db),
        args.challenge_id,
        transcript=transcript,
        command=" ".join(command),
        test_flag=args.test_flag,
        docker_image=args.image,
    )
    print(f"UPDATED {args.challenge_id} status={summary['status']} proof_status={summary['proof_status']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
