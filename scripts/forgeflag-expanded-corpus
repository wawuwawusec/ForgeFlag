#!/usr/bin/env python3
from __future__ import annotations

import argparse
import base64
import json
from pathlib import Path
import socket
import socketserver
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import zipfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


ROOT = Path(__file__).resolve().parents[1]
WORKDIR = ROOT / ".forgeflag" / "expanded-corpus"
SOURCES = {
    "pico": "https://picoctfsolutions.com/",
    "hacktricks_crypto": "https://hacktricks.wiki/en/crypto/ctf-workflow/index.html",
    "hacktricks_stego": "https://hacktricks.wiki/stego/index.html",
    "hacktricks_forensics": "https://book.hacktricks.wiki/en/generic-methodologies-and-resources/basic-forensic-methodology/index.html",
    "htb_ca_2024": "https://github.com/hackthebox/cyber-apocalypse-2024",
    "ductf_2024": "https://github.com/DownUnderCTF/Challenges_2024_Public",
    "ductf_stats": "https://downunderctf.com/blog/2024/ctf-statistics/",
    "ybn_2024": "https://hackmd.io/%40ctf-lol/ybnctf2024",
    "nyu_ctf_bench": "https://proceedings.neurips.cc/paper_files/paper/2024/file/69d97a6493fbf016fff0a751f253ad18-Paper-Datasets_and_Benchmarks_Track.pdf",
    "ir0nstone": "https://ir0nstone.gitbook.io/notes/binexp/stack/ret2win",
}


def main() -> int:
    parser = argparse.ArgumentParser(description="Run a broad public-CTF-pattern corpus through ForgeFlag Web.")
    parser.add_argument("--url", default="http://127.0.0.1:8080", help="ForgeFlag Web UI base URL")
    parser.add_argument("--list", action="store_true", help="List expanded corpus cases without running them")
    parser.add_argument("--keep", action="store_true", help="Keep generated challenges in the Web notebook after running")
    parser.add_argument("--strict", action="store_true", help="Exit non-zero when any case score is incomplete")
    parser.add_argument("--llm", action="store_true", help="Enable configured LLM planning for benchmark runs")
    args = parser.parse_args()

    WORKDIR.mkdir(parents=True, exist_ok=True)
    fixtures = build_fixtures()
    cases = expanded_cases(fixtures)
    if args.list:
        print(json.dumps({"cases": [_case_listing(case) for case in cases]}, indent=2, ensure_ascii=False))
        return 0

    web_server = start_web_server()
    service_server = start_tcp_server(b"ready\nflag{expanded_pwn_service_banner}\n")
    rows: list[dict[str, object]] = []
    try:
        for case in cases:
            delete_challenge(args.url, str(case["challenge_id"]))
            create_challenge(args.url, case, service_server.server_address[1])
            summary = run_challenge(args.url, case, llm_enabled=args.llm)
            findings = get_json(args.url, f"/api/challenges/{case['challenge_id']}/findings")
            observations = get_json(args.url, f"/api/challenges/{case['challenge_id']}/observations")
            report = get_json(args.url, f"/api/challenges/{case['challenge_id']}/report")
            rows.append(score_case(case, summary, findings, observations, report))
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        if args.strict and any(not row["ok"] for row in rows):
            return 1
        return 0
    finally:
        web_server.shutdown()
        web_server.server_close()
        service_server.shutdown()
        service_server.server_close()
        if not args.keep:
            for case in cases:
                delete_challenge(args.url, str(case["challenge_id"]))


def build_fixtures() -> dict[str, Path]:
    fixtures: dict[str, Path] = {}

    def write_text(name: str, text: str) -> Path:
        path = WORKDIR / name
        path.write_text(text, encoding="utf-8")
        fixtures[name] = path
        return path

    def write_bytes(name: str, data: bytes) -> Path:
        path = WORKDIR / name
        path.write_bytes(data)
        fixtures[name] = path
        return path

    write_text("crypto_hex.txt", "666c61677b657870616e6465645f6865787d")
    write_text("crypto_base32.txt", base64.b32encode(b"flag{expanded_base32}").decode("ascii").rstrip("="))
    write_text("crypto_base64.txt", base64.b64encode(b"flag{expanded_base64}").decode("ascii"))
    write_text("crypto_binary.txt", " ".join(f"{byte:08b}" for byte in b"flag{expanded_binary}"))
    write_text("crypto_rot13.txt", "synt{rkcnaqrq_ebg13}")
    write_text("crypto_caesar.txt", "mshn{lewhuklk_jhlzhy}")
    write_text("crypto_morse.txt", "..-. .-.. .- --. / -.-. .-. -.-- .--. - --- / -- --- .-. ... .")
    write_text("crypto_decimal.txt", " ".join(str(byte) for byte in b"flag{expanded_decimal}"))
    write_text("crypto_octal.txt", " ".join(format(byte, "o") for byte in b"flag{expanded_octal}"))
    single_xor_plaintext = b"flag{expanded_single_xor}"
    write_text("crypto_single_xor.txt", "single byte xor ciphertext = " + bytes(byte ^ 0x37 for byte in single_xor_plaintext).hex())
    repeating_xor_plaintext = b"flag{expanded_repeating_xor}"
    repeating_xor_key = b"ice"
    write_text(
        "crypto_repeating_xor.txt",
        "key = ice\nct = "
        + bytes(byte ^ repeating_xor_key[index % len(repeating_xor_key)] for index, byte in enumerate(repeating_xor_plaintext)).hex(),
    )
    write_text("crypto_vigenere.txt", "vigenere key = lemon\nvigenere ciphertext = qpmu{ritmbqph_hwtprqfr}\n")
    p, q, e = 2**127 - 1, 2**89 - 1, 65537
    n = p * q
    message = int.from_bytes(b"flag{expanded_rsa}", "big")
    write_text("crypto_rsa.txt", f"n = {n}\ne = {e}\nc = {pow(message, e, n)}\np = {p}\nq = {q}\n")

    write_bytes("forensics_strings.bin", b"\x00log\x00flag{expanded_forensics_strings}\x00")
    fixtures["forensics_zip.zip"] = write_zip("forensics_zip.zip", {"flag.txt": "flag{expanded_forensics_zip}"})
    write_bytes("forensics_png_text.png", png_text("flag{expanded_forensics_png_text}"))
    write_bytes("forensics_png_trailing.png", png_text("note") + b"flag{expanded_forensics_trailing}")
    write_bytes("forensics_jpeg_comment.jpg", jpeg_comment("flag{expanded_forensics_jpeg_comment}"))
    write_bytes("forensics_log.bin", b"timeline event\npowershell -enc ZmxhZ3tleHBhbmRlZF9mb3JlbnNpY3NfbG9nfQ==\n")
    for index in range(6, 10):
        write_bytes(f"forensics_blob_{index}.bin", f"artifact {index}\nflag{{expanded_forensics_blob_{index}}}\n".encode())

    for index in range(10):
        write_http_pcap(WORKDIR / f"traffic_http_{index}.pcap", f"flag{{expanded_traffic_http_{index}}}\n".encode())
        fixtures[f"traffic_http_{index}.pcap"] = WORKDIR / f"traffic_http_{index}.pcap"
    for index in range(3):
        write_dns_pcap(WORKDIR / f"traffic_dns_{index}.pcap", f"flag{{expanded_traffic_dns_{index}}}")
        fixtures[f"traffic_dns_{index}.pcap"] = WORKDIR / f"traffic_dns_{index}.pcap"
    for index in range(2):
        write_smtp_pcap(WORKDIR / f"traffic_smtp_{index}.pcap", f"flag{{expanded_traffic_smtp_{index}}}".encode())
        fixtures[f"traffic_smtp_{index}.pcap"] = WORKDIR / f"traffic_smtp_{index}.pcap"

    for index in range(8):
        source = write_text(
            f"reverse_{index}.c",
            f'#include <stdio.h>\nconst char *flag = "flag{{expanded_reverse_{index}}}";\nint main(void){{puts("rev"); return flag[0] == 0;}}\n',
        )
        output = WORKDIR / f"reverse_{index}"
        compile_c(source, output)
        fixtures[f"reverse_{index}"] = output
    packed = write_text("reverse_packed.c", 'const char *m = "UPX packed marker"; int main(){return m[0];}\n')
    compile_c(packed, WORKDIR / "reverse_packed")
    fixtures["reverse_packed"] = WORKDIR / "reverse_packed"
    encoded = write_text("reverse_encoded.c", 'const char *m = "synt{rkcnaqrq_erirefr_ebg13}"; int main(){return m[0];}\n')
    compile_c(encoded, WORKDIR / "reverse_encoded")
    fixtures["reverse_encoded"] = WORKDIR / "reverse_encoded"

    for index in range(4):
        source = write_text(
            f"pwn_flag_{index}.c",
            f'#include <stdio.h>\nconst char *flag = "flag{{expanded_pwn_string_{index}}}";\nint main(void){{char buf[16]; puts("pwn"); return flag[0] == 0 && sizeof(buf) == 0;}}\n',
        )
        output = WORKDIR / f"pwn_flag_{index}"
        compile_c(source, output)
        fixtures[f"pwn_flag_{index}"] = output
    for index in range(3):
        write_text(
            f"pwn_ret2win_{index}.c",
            "#include <stdio.h>\nvoid win(void){puts(\"shell\");}\nint main(void){char buf[64]; gets(buf); return 0;}\n",
        )
    for index in range(2):
        write_text(
            f"pwn_format_{index}.c",
            "#include <stdio.h>\nint main(void){char name[128]; fgets(name,sizeof(name),stdin); printf(name); return 0;}\n",
        )

    write_text("misc_binary.txt", " ".join(f"{byte:08b}" for byte in b"flag{expanded_misc_binary}"))
    write_text("misc_caesar.txt", "mshn{lewhuklk_tpzj_jhlzhy}")
    write_text("misc_morse.txt", "..-. .-.. .- --. / -- .. ... -.-. / -- --- .-. ... .")
    write_text("misc_decimal.txt", " ".join(str(byte) for byte in b"flag{expanded_misc_decimal}"))
    write_text("misc_octal.txt", " ".join(format(byte, "o") for byte in b"flag{expanded_misc_octal}"))
    write_text("misc_nested_base.txt", base64.b64encode(b"&#102;&#108;&#97;&#103;&#123;&#101;&#120;&#112;&#97;&#110;&#100;&#101;&#100;&#95;&#109;&#105;&#115;&#99;&#95;&#104;&#116;&#109;&#108;&#125;").decode())
    fixtures["misc_zip.zip"] = write_zip("misc_zip.zip", {"secret/flag.txt": "flag{expanded_misc_zip}"})
    write_bytes("misc_png.png", png_text("flag{expanded_misc_png}"))
    write_text("misc_pickle.py", "import pickle\nBLACKLIST=['os','system']\nblob=input()\npickle.loads(bytes.fromhex(blob))\n")
    write_text("misc_hash.txt", "5d41402abc4b2a76b9719d911017c592")

    write_text(
        "web_source.py",
        "from flask import Flask, request, session\nimport jwt, requests\napp=Flask(__name__)\n"
        "@app.route('/api/options')\ndef o(): return {'commands':['flag']}\n"
        "@app.route('/fetch')\ndef f(): return requests.get(request.args['url']).text\n"
        "@app.route('/download')\ndef d(): return open(request.args['file']).read()\n",
    )
    write_text("web_jwt.js", "app.get('/profile',(req,res)=>jwt.verify(req.cookies.token, 'secret'))")
    write_text("web_ssrf.py", "requests.get(request.args['url'])")
    write_text("web_path.py", "open(request.args['file']).read()")

    return fixtures


def expanded_cases(fixtures: dict[str, Path]) -> list[dict[str, object]]:
    cases: list[dict[str, object]] = []
    add = cases.append

    web_targets = [
        ("web-visible", "/visible", "flag{expanded_web_visible}", ["flag{expanded_web_visible}"], SOURCES["pico"]),
        ("web-link", "/link", "flag{expanded_web_link}", ["/flag", "flag{expanded_web_link}"], SOURCES["pico"]),
        ("web-script-api", "/script", "flag{expanded_web_script}", ["/api/options", "flag{expanded_web_script}"], SOURCES["htb_ca_2024"]),
        ("web-plain-lfi", "/portal", None, ["LFI", "WAR", "Java"], SOURCES["nyu_ctf_bench"]),
        ("web-form", "/form", None, ["forms", "login"], SOURCES["pico"]),
        ("web-hidden-js", "/hidden-js", "flag{expanded_web_hidden_js}", ["/api/hidden", "flag{expanded_web_hidden_js}"], SOURCES["ybn_2024"]),
        ("web-header-cookie", "/header-cookie", "flag{expanded_web_header_cookie}", ["X-Flag-Hint", "session", "flag{expanded_web_header_cookie}"], SOURCES["hacktricks_forensics"]),
    ]
    for challenge_id, path, flag, evidence, source_url in web_targets:
        add(case(challenge_id, "web", "expanded", f"Web {challenge_id}", target=f"http://127.0.0.1:18094{path}", expected_flag=flag, required_evidence=evidence, source_url=source_url, active_probe=True))
    for name, evidence in [
        ("web_source.py", ["/api/options", "SSRF", "path traversal"]),
        ("web_jwt.js", ["JWT/session"]),
        ("web_ssrf.py", ["SSRF"]),
        ("web_path.py", ["path traversal"]),
    ]:
        add(case(f"web-source-{Path(name).stem}", "web", "expanded", f"Web source {name}", attachments=[fixtures[name]], expected_flag=None, required_evidence=evidence, source_url=SOURCES["hacktricks_forensics"]))

    for name, expected, evidence in [
        ("crypto_hex.txt", "flag{expanded_hex}", ["hex_decode"]),
        ("crypto_base32.txt", "flag{expanded_base32}", ["base32_decode"]),
        ("crypto_base64.txt", "flag{expanded_base64}", ["base64_decode"]),
        ("crypto_binary.txt", "flag{expanded_binary}", ["binary_ascii_decode"]),
        ("crypto_rot13.txt", "flag{expanded_rot13}", ["rot13_decode"]),
        ("crypto_caesar.txt", "flag{expanded_caesar}", ["caesar_shift"]),
        ("crypto_morse.txt", "flag{crypto_morse}", ["morse_decode"]),
        ("crypto_decimal.txt", "flag{expanded_decimal}", ["decimal_ascii_decode"]),
        ("crypto_octal.txt", "flag{expanded_octal}", ["octal_ascii_decode"]),
        ("crypto_single_xor.txt", "flag{expanded_single_xor}", ["single_byte_xor"]),
        ("crypto_repeating_xor.txt", "flag{expanded_repeating_xor}", ["repeating_key_xor"]),
        ("crypto_vigenere.txt", "flag{expanded_vigenere}", ["vigenere"]),
        ("crypto_rsa.txt", "flag{expanded_rsa}", ["known_factors"]),
    ]:
        add(case(f"crypto-{Path(name).stem}", "crypto", "expanded", f"Crypto {name}", attachments=[fixtures[name]], expected_flag=expected, required_evidence=evidence, source_url=SOURCES["hacktricks_crypto"]))

    for index, name in enumerate(["forensics_strings.bin", "forensics_zip.zip", "forensics_png_text.png", "forensics_png_trailing.png", "forensics_jpeg_comment.jpg", "forensics_log.bin", "forensics_blob_6.bin", "forensics_blob_7.bin", "forensics_blob_8.bin", "forensics_blob_9.bin"]):
        add(case(f"forensics-{index}", "forensics", "expanded", f"Forensics {name}", attachments=[fixtures[name]], expected_flag=_first_flag_hint(name, "forensics", index), required_evidence=["flag{"], source_url=SOURCES["hacktricks_stego"]))

    traffic_names = [*(f"traffic_http_{i}.pcap" for i in range(5)), *(f"traffic_dns_{i}.pcap" for i in range(3)), *(f"traffic_smtp_{i}.pcap" for i in range(2))]
    for index, name in enumerate(traffic_names):
        expected = f"flag{{expanded_traffic_{'http' if 'http' in name else 'dns' if 'dns' in name else 'smtp'}_{name.split('_')[-1].split('.')[0]}}}"
        add(case(f"traffic-{index}", "traffic", "expanded", f"Traffic {name}", attachments=[fixtures[name]], expected_flag=expected, required_evidence=["flag{"], source_url=SOURCES["nyu_ctf_bench"]))

    for index in range(8):
        add(case(f"reverse-string-{index}", "reverse", "expanded", f"Reverse string {index}", attachments=[fixtures[f"reverse_{index}"]], expected_flag=f"flag{{expanded_reverse_{index}}}", required_evidence=["strings"], source_url=SOURCES["ductf_2024"]))
    add(case("reverse-packed", "reverse", "expanded", "Reverse packed", attachments=[fixtures["reverse_packed"]], expected_flag=None, required_evidence=["UPX", "packed"], source_url=SOURCES["htb_ca_2024"]))
    add(case("reverse-encoded", "reverse", "expanded", "Reverse encoded", attachments=[fixtures["reverse_encoded"]], expected_flag=None, required_evidence=["synt", "strings"], source_url=SOURCES["pico"]))

    for index in range(4):
        add(case(f"pwn-string-{index}", "pwn", "expanded", f"Pwn string {index}", attachments=[fixtures[f"pwn_flag_{index}"]], expected_flag=f"flag{{expanded_pwn_string_{index}}}", required_evidence=["checksec"], source_url=SOURCES["pico"]))
    for index in range(3):
        add(case(f"pwn-ret2win-{index}", "pwn", "expanded", f"Pwn ret2win {index}", attachments=[fixtures[f"pwn_ret2win_{index}.c"]], expected_flag=None, required_evidence=["ret2win", "cyclic", "pwntools"], source_url=SOURCES["ir0nstone"]))
    for index in range(2):
        add(case(f"pwn-format-{index}", "pwn", "expanded", f"Pwn format {index}", attachments=[fixtures[f"pwn_format_{index}.c"]], expected_flag=None, required_evidence=["format string", "pwntools"], source_url=SOURCES["htb_ca_2024"]))
    add(case("pwn-service-banner", "pwn", "expanded", "Pwn service banner", target="{service_target}", expected_flag="flag{expanded_pwn_service_banner}", required_evidence=["tcp"], source_url=SOURCES["nyu_ctf_bench"], active_probe=True))

    for name, expected, evidence in [
        ("misc_binary.txt", "flag{expanded_misc_binary}", ["binary_ascii_decode"]),
        ("misc_caesar.txt", "flag{expanded_misc_caesar}", ["caesar_shift"]),
        ("misc_morse.txt", "flag{misc_morse}", ["morse_decode"]),
        ("misc_decimal.txt", "flag{expanded_misc_decimal}", ["decimal_ascii_decode"]),
        ("misc_octal.txt", "flag{expanded_misc_octal}", ["octal_ascii_decode"]),
        ("misc_nested_base.txt", "flag{expanded_misc_html}", ["base64_decode", "html_unescape"]),
        ("misc_zip.zip", "flag{expanded_misc_zip}", ["archive"]),
        ("misc_png.png", "flag{expanded_misc_png}", ["image_stego"]),
        ("misc_pickle.py", None, ["pickle", "sandbox"]),
        ("misc_hash.txt", None, ["hashcat"]),
    ]:
        add(case(f"misc-{Path(name).stem}", "misc", "expanded", f"Misc {name}", attachments=[fixtures[name]], expected_flag=expected, required_evidence=evidence, source_url=SOURCES["pico"]))

    return cases


def case(challenge_id: str, category: str, difficulty: str, title: str, *, target: str = "", attachments: list[Path] | None = None, expected_flag: str | None, required_evidence: list[str], source_url: str, active_probe: bool = False) -> dict[str, object]:
    return {
        "challenge_id": f"expanded-{challenge_id}",
        "category": category,
        "difficulty": difficulty,
        "title": title,
        "description": f"Expanded benchmark pattern distilled from public CTF writeups and practice notes: {title}.",
        "target": target,
        "attachments": attachments or [],
        "active_probe": active_probe,
        "expected_flag": expected_flag,
        "required_evidence": required_evidence,
        "source_url": source_url,
    }


def _first_flag_hint(name: str, category: str, index: int) -> str:
    if name == "forensics_strings.bin":
        return "flag{expanded_forensics_strings}"
    if name == "forensics_zip.zip":
        return "flag{expanded_forensics_zip}"
    if name == "forensics_png_text.png":
        return "flag{expanded_forensics_png_text}"
    if name == "forensics_png_trailing.png":
        return "flag{expanded_forensics_trailing}"
    if name == "forensics_jpeg_comment.jpg":
        return "flag{expanded_forensics_jpeg_comment}"
    if name == "forensics_log.bin":
        return "flag{expanded_forensics_log}"
    return f"flag{{expanded_{category}_blob_{index}}}"


def _case_listing(case: dict[str, object]) -> dict[str, object]:
    return {
        key: case[key]
        for key in ("challenge_id", "category", "difficulty", "title", "expected_flag", "required_evidence", "source_url")
    }


def create_challenge(base_url: str, case: dict[str, object], service_port: int) -> None:
    target = str(case.get("target") or "")
    if target == "{service_target}":
        target = f"127.0.0.1:{service_port}"
    payload = {
        "challenge_id": case["challenge_id"],
        "category": case["category"],
        "title": case["title"],
        "target": target,
        "description": case["description"],
        "tags": f"expanded-corpus,{case['difficulty']},{case['category']}",
        "attachments": [
            {"name": path.name, "content_base64": base64.b64encode(path.read_bytes()).decode("ascii")}
            for path in case.get("attachments", [])
        ],
    }
    post_json(base_url, "/api/challenges", payload)


def run_challenge(base_url: str, case: dict[str, object], llm_enabled: bool) -> dict[str, object]:
    return post_json(
        base_url,
        f"/api/challenges/{case['challenge_id']}/run",
        {
            "active_probe": case["active_probe"],
            "allowed_hosts": "127.0.0.1,localhost",
            "llm_enabled": llm_enabled,
            "llm_provider": "zhipu" if llm_enabled else "disabled",
        },
    )


def score_case(case: dict[str, object], summary: dict[str, object], findings: object, observations: object, report: object) -> dict[str, object]:
    haystack = json.dumps({"summary": summary, "findings": findings, "observations": observations, "report": report}, ensure_ascii=False)
    accepted = summary.get("accepted_flags", []) if isinstance(summary, dict) else []
    expected_flag = case.get("expected_flag")
    flag_ok = expected_flag is None or expected_flag in accepted
    required = [str(item) for item in case["required_evidence"]]
    matched = [item for item in required if item.lower() in haystack.lower()]
    missing = [item for item in required if item not in matched]
    return {
        "challenge_id": case["challenge_id"],
        "category": case["category"],
        "status": summary.get("status") if isinstance(summary, dict) else "unknown",
        "expected_flag": expected_flag,
        "accepted_flags": accepted,
        "flag_ok": flag_ok,
        "matched_evidence": matched,
        "missing_evidence": missing,
        "score": (1 if flag_ok else 0) + len(matched),
        "max_score": 1 + len(required),
        "ok": flag_ok and not missing,
        "source_url": case["source_url"],
    }


class ExpandedWebHandler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        routes: dict[str, tuple[bytes, str]] = {
            "/visible": (b"flag{expanded_web_visible}", "text/plain"),
            "/link": (b'<!doctype html><a href="/flag">flag</a>', "text/html"),
            "/flag": (b"flag{expanded_web_link}", "text/plain"),
            "/script": (b'<!doctype html><script>fetch("/api/options")</script>', "text/html"),
            "/api/options": (b'{"hidden_api":"flag{expanded_web_script}"}', "application/json"),
            "/portal": (b"Portal LFI accepts file:// URLs. Read /opt/tomcat/webapps/ROOT.war for Java analysis.", "text/plain"),
            "/form": (b'<form method="post" action="/login"><input name="username"><input name="password"></form>', "text/html"),
            "/hidden-js": (b'<!doctype html><script>const path="/api/hidden"; fetch(path)</script>', "text/html"),
            "/api/hidden": (b"flag{expanded_web_hidden_js}", "text/plain"),
            "/header-cookie": (b"<!doctype html><title>Header Cookie</title><p>inspect metadata</p>", "text/html"),
        }
        body, content_type = routes.get(self.path, (b"not found", "text/plain"))
        self.send_response(200 if self.path in routes else 404)
        self.send_header("content-type", content_type)
        if self.path == "/header-cookie":
            self.send_header("X-Flag-Hint", "flag{expanded_web_header_cookie}")
            self.send_header("Set-Cookie", "session=flag{expanded_web_header_cookie}; HttpOnly; Path=/")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        return


def start_web_server() -> ThreadingHTTPServer:
    server = ThreadingHTTPServer(("127.0.0.1", 18094), ExpandedWebHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def start_tcp_server(payload: bytes) -> ThreadingHTTPServer:
    class Handler(socketserver.BaseRequestHandler):  # type: ignore[name-defined]
        def handle(self) -> None:
            self.request.sendall(payload)

    server = socketserver.TCPServer(("127.0.0.1", 0), Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def post_json(base_url: str, path: str, payload: dict[str, object]) -> dict[str, object]:
    request = urllib.request.Request(base_url.rstrip("/") + path, data=json.dumps(payload).encode("utf-8"), headers={"content-type": "application/json"}, method="POST")
    with urllib.request.urlopen(request, timeout=60) as response:
        return json.loads(response.read().decode("utf-8"))


def get_json(base_url: str, path: str) -> dict[str, object] | list[dict[str, object]]:
    with urllib.request.urlopen(base_url.rstrip("/") + path, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def delete_challenge(base_url: str, challenge_id: str) -> None:
    request = urllib.request.Request(base_url.rstrip("/") + f"/api/challenges/{challenge_id}", method="DELETE")
    try:
        with urllib.request.urlopen(request, timeout=20):
            return
    except (urllib.error.HTTPError, urllib.error.URLError):
        return


def compile_c(source: Path, output: Path) -> None:
    subprocess.run(["clang", str(source), "-o", str(output)], check=True)


def write_zip(name: str, entries: dict[str, str]) -> Path:
    path = WORKDIR / name
    with zipfile.ZipFile(path, "w") as zf:
        for entry_name, content in entries.items():
            zf.writestr(entry_name, content)
    return path


def png_text(text: str) -> bytes:
    import binascii
    import zlib

    def chunk(kind: bytes, data: bytes) -> bytes:
        return len(data).to_bytes(4, "big") + kind + data + binascii.crc32(kind + data).to_bytes(4, "big")

    raw = b"\x00\x00\x00\x00"
    return (
        b"\x89PNG\r\n\x1a\n"
        + chunk(b"IHDR", b"\x00\x00\x00\x01\x00\x00\x00\x01\x08\x02\x00\x00\x00")
        + chunk(b"tEXt", b"Comment\x00" + text.encode())
        + chunk(b"IDAT", zlib.compress(raw))
        + chunk(b"IEND", b"")
    )


def jpeg_comment(text: str) -> bytes:
    data = text.encode()
    return b"\xff\xd8" + b"\xff\xfe" + (len(data) + 2).to_bytes(2, "big") + data + b"\xff\xd9"


def write_http_pcap(path: Path, payload: bytes) -> None:
    packet = ethernet_frame(ipv4_packet(tcp_segment(b"GET / HTTP/1.1\r\nHost: expanded.test\r\n\r\n" + payload), protocol=6))
    write_pcap(path, packet)


def write_dns_pcap(path: Path, flag: str) -> None:
    encoded = base64.b32encode(flag.encode()).decode("ascii").rstrip("=").lower()
    query = ".".join([encoded[:18], encoded[18:36], encoded[36:]]) + ".exfil.test"
    packet = ethernet_frame(ipv4_packet(udp_datagram(dns_query(query))))
    write_pcap(path, packet)


def write_smtp_pcap(path: Path, flag: bytes) -> None:
    payload = b"220 mail\r\nEHLO player\r\nDATA\r\nSubject: clue\r\n" + flag + b"\r\n.\r\nQUIT\r\n"
    packet = ethernet_frame(ipv4_packet(tcp_custom_segment(payload, 53333, 25), protocol=6))
    write_pcap(path, packet)


def write_pcap(path: Path, packet: bytes) -> None:
    with path.open("wb") as handle:
        handle.write(struct.pack("<IHHIIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
        handle.write(struct.pack("<IIII", int(time.time()), 0, len(packet), len(packet)))
        handle.write(packet)


def dns_query(name: str) -> bytes:
    labels = b"".join(bytes([len(part)]) + part.encode("ascii") for part in name.split(".") if part)
    return struct.pack("!HHHHHH", 0x4343, 0x0100, 1, 0, 0, 0) + labels + b"\x00" + struct.pack("!HH", 1, 1)


def udp_datagram(payload: bytes) -> bytes:
    return struct.pack("!HHHH", 53000, 53, 8 + len(payload), 0) + payload


def tcp_segment(payload: bytes) -> bytes:
    return tcp_custom_segment(payload, 4444, 80)


def tcp_custom_segment(payload: bytes, src_port: int, dst_port: int) -> bytes:
    return struct.pack("!HHIIHHHH", src_port, dst_port, 1, 1, (5 << 12) | 0x18, 8192, 0, 0) + payload


def ipv4_packet(payload: bytes, protocol: int = 17) -> bytes:
    src, dst = socket.inet_aton("10.10.10.2"), socket.inet_aton("8.8.8.8")
    header = struct.pack("!BBHHHBBH4s4s", 0x45, 0, 20 + len(payload), 1, 0x4000, 64, protocol, 0, src, dst)
    checksum = internet_checksum(header)
    return struct.pack("!BBHHHBBH4s4s", 0x45, 0, 20 + len(payload), 1, 0x4000, 64, protocol, checksum, src, dst) + payload


def ethernet_frame(payload: bytes) -> bytes:
    return b"\xaa\xaa\xaa\xaa\xaa\xaa" + b"\xbb\xbb\xbb\xbb\xbb\xbb" + b"\x08\x00" + payload


def internet_checksum(data: bytes) -> int:
    if len(data) % 2:
        data += b"\x00"
    total = sum(struct.unpack("!%dH" % (len(data) // 2), data))
    while total >> 16:
        total = (total & 0xFFFF) + (total >> 16)
    return (~total) & 0xFFFF


if __name__ == "__main__":
    raise SystemExit(main())
